<!-- ====== SLIDE 2: Today's Arc ====== -->
<section class="slide" id="s2">
  <span class="logo">&lt;mdp&gt;</span>
  <span class="section-num">01</span>
  <div class="label">Today's Arc</div>
  <h2>Three layers, one day</h2>

  <div class="cards" style="grid-template-columns: repeat(3, 1fr);">
