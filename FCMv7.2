<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Day 6: From App to Product | HDS 2026</title>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bg-dark: #111111;
    --bg-light: #FAFAFA;
    --bg-card: #FFFFFF;
    --text-primary: #111111;
    --text-secondary: #555555;
    --text-light: #FAFAFA;
    --text-muted: #888888;
    --accent: #10B981;
    --accent-dim: #064E3B;
    --border: #E5E5E5;
    --code-bg: #1E1E1E;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Inter', -apple-system, sans-serif;
    background: var(--bg-light);
    color: var(--text-primary);
    line-height: 1.6;
  }

  /* Slide container */
  .slide {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem 8%;
    position: relative;
    border-bottom: 1px solid var(--border);
  }

  .slide.dark {
    background: var(--bg-dark);
    color: var(--text-light);
  }

  .slide.dark .text-secondary { color: #AAAAAA; }
  .slide.dark .text-muted { color: #777777; }

  /* Typography */
  h1 {
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }

  h2 {
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  h3 {
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  .subtitle {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    color: var(--text-secondary);
    max-width: 700px;
    line-height: 1.7;
  }

  .slide.dark .subtitle { color: #BBBBBB; }

  .label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .big-number {
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(4rem, 10vw, 8rem);
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
  }

  /* Accent line */
  .accent-bar {
    width: 60px;
    height: 4px;
    background: var(--accent);
    margin-bottom: 1.5rem;
    border-radius: 2px;
  }

  /* Cards grid */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
    max-width: 1200px;
  }

  .card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem;
    transition: transform 0.2s;
  }

  .card:hover { transform: translateY(-2px); }

  .slide.dark .card {
    background: #1A1A1A;
    border-color: #333;
  }

  .card-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .card h3 { margin-bottom: 0.5rem; }
  .card p { color: var(--text-secondary); font-size: 0.95rem; }
  .slide.dark .card p { color: #999; }

  /* Two column */
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    margin-top: 2rem;
    max-width: 1200px;
  }

  @media (max-width: 768px) {
    .two-col { grid-template-columns: 1fr; gap: 2rem; }
    .slide { padding: 3rem 6%; }
  }

  /* Compare columns */
  .compare-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.3rem 0.8rem;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: 1rem;
  }

  .compare-label.before {
    background: #FEE2E2;
    color: #991B1B;
  }

  .compare-label.after {
    background: #D1FAE5;
    color: #065F46;
  }

  .slide.dark .compare-label.before {
    background: #3B1111;
    color: #FCA5A5;
  }

  .slide.dark .compare-label.after {
    background: #052E16;
    color: #6EE7B7;
  }

  /* Timeline / schedule */
  .schedule-item {
    display: flex;
    gap: 2rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
    align-items: baseline;
  }

  .slide.dark .schedule-item { border-color: #333; }

  .schedule-time {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--accent);
    min-width: 120px;
    flex-shrink: 0;
  }

  .schedule-content h3 {
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }

  .schedule-content p {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .slide.dark .schedule-content p { color: #999; }

  /* Discussion questions */
  .question-list {
    list-style: none;
    margin-top: 1.5rem;
    max-width: 800px;
  }

  .question-list li {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 1.1rem;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .slide.dark .question-list li { border-color: #333; }

  .q-number {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    min-width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--accent);
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Code block style */
  .code-block {
    font-family: 'JetBrains Mono', monospace;
    background: var(--code-bg);
    color: #E5E5E5;
    padding: 1.5rem 2rem;
    border-radius: 8px;
    font-size: 0.85rem;
    line-height: 1.8;
    margin-top: 1.5rem;
    max-width: 800px;
    overflow-x: auto;
  }

  .code-comment { color: #6A9955; }
  .code-keyword { color: #569CD6; }
  .code-string { color: #CE9178; }

  /* Arrow diagram */
  .flow {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .flow-step {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.6rem 1.2rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .slide.dark .flow-step {
    background: #1A1A1A;
    border-color: #333;
  }

  .flow-arrow {
    color: var(--accent);
    font-size: 1.2rem;
  }

  /* Pull quote */
  .pull-quote {
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 300;
    line-height: 1.5;
    max-width: 800px;
    padding-left: 2rem;
    border-left: 4px solid var(--accent);
    margin-top: 2rem;
  }

  /* Section number */
  .section-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    position: absolute;
    top: 2rem;
    right: 3rem;
  }

  /* MDP logo placeholder */
  .logo {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted);
    position: absolute;
    top: 2rem;
    left: 3rem;
    letter-spacing: 0.05em;
  }

  .slide.dark .logo { color: #666; }
  .slide.dark .section-num { color: #666; }

  /* Feature ownership */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-top: 2rem;
    max-width: 1000px;
  }

  .feature-slot {
    border: 2px dashed #333;
    border-radius: 10px;
    padding: 1.5rem;
    text-align: center;
    min-height: 140px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
  }

  .feature-slot .slot-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .feature-slot .slot-desc {
    font-size: 0.8rem;
    color: #777;
  }

  .feature-slot .slot-owner {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--accent);
    margin-top: 0.5rem;
  }

  /* Nav dots */
  .nav {
    position: fixed;
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 8px;
    z-index: 100;
  }

  .nav a {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #CCC;
    display: block;
    transition: all 0.2s;
  }

  .nav a:hover, .nav a.active {
    background: var(--accent);
    transform: scale(1.3);
  }
</style>
</head>
<body>

<!-- Nav dots -->
<nav class="nav" id="navDots"></nav>

<!-- ====== SLIDE 1: Title ====== -->
